       "[                                         (-g*m*cos(phi)*cos(theta) + k_f*tau1 + k_f*tau2 + k_f*tau3 + k_f*tau4 + m*v_x*w_y - m*v_y*w_x)/m],\n",
       "[                                                                                       (Jy*w_y*w_z - Jz*w_y*w_z + k_f*l*(tau2 - tau4))/Jx],\n",
